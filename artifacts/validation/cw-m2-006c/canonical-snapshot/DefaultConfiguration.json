" color=\"#aa0000\">\r\n                            <div class=\"confirmCode\"><blockquote><a href=\"##CALLBACKURL##\">Click here to reset your password</a></blockquote></div>\r\n                        </font>\r\n                        <br />Thanks,<br />\r\n                        &nbsp;&nbsp;&nbsp;&nbsp;##SITENAME##\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</body>\r\n</html>","DataTypeId":5,"ConfigurationEntryDescription":"HTML email template to use when sending a password reset email.","ConfigurationGroupDescription":"Membership settings such as defaults for new members and permissions.","IsEncrypted":0,"IsRequired":1},
