{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cw-m5-026b-stopped-source-restart-v1",
  "title": "Sanitized result of one CW-M5-026B source start",
  "type": "object",
  "additionalProperties": false,
  "required": ["ReportVersion", "Classification", "TargetRole", "ExpectedContainerId", "TargetContainerName", "StartExitCode", "PodmanStartCommands", "PodmanCommandsAreStartOnly", "PostStartIdentityVerification", "RawPodmanOutputPersisted", "StderrPersisted", "DatabaseConnections", "DatabaseMutations", "CredentialsRead", "AuthorizationApprovalId", "ManifestSha256", "DiagnosticReportSha256", "PreflightReportSha256", "GeneratedAtUtc"],
  "properties": {
    "ReportVersion": {"const": "cw-m5-026b-stopped-source-start-v1"},
    "Classification": {"enum": ["SOURCE_CONTAINER_START_SUCCEEDED", "SOURCE_CONTAINER_START_FAILED"]},
    "TargetRole": {"const": "Source"},
    "ExpectedContainerId": {"const": "6a4d4f8707ee4f5b14dddfff183db6d26ce7453eaba377b7c9d081bc1157f914"},
    "TargetContainerName": {"const": "continuumwiki-m5-026b-source-ro1"},
    "StartExitCode": {"type": "integer", "minimum": 0, "maximum": 255},
    "PodmanStartCommands": {"const": 1},
    "PodmanCommandsAreStartOnly": {"const": true},
    "PostStartIdentityVerification": {"const": "NOT_AUTHORIZED"},
    "RawPodmanOutputPersisted": {"const": false},
    "StderrPersisted": {"const": false},
    "DatabaseConnections": {"const": 0},
    "DatabaseMutations": {"const": 0},
    "CredentialsRead": {"const": 0},
    "AuthorizationApprovalId": {"type": "string", "pattern": "^CW-M5-026B-RECOVERY-START-[A-Za-z0-9._:-]{1,80}$"},
    "ManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "DiagnosticReportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "PreflightReportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "GeneratedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
