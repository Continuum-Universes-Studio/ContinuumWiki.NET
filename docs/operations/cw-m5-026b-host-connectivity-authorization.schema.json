{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuumwiki.invalid/schemas/cw-m5-026b-host-connectivity-v1.json",
  "title": "CW-M5-026B bounded host connectivity authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["ManifestVersion", "ApprovalId", "ApprovedAtUtc", "ExpiresAtUtc", "Approver", "Operator", "ExecutionHost", "Targets", "PermittedOperations", "Limits", "Evidence"],
  "properties": {
    "ManifestVersion": {"const": "cw-m5-026b-host-connectivity-v1"},
    "ApprovalId": {"type": "string", "pattern": "^CW-M5-026B-(HOST-)?CONNECTIVITY-[A-Za-z0-9._:-]{1,96}$"},
    "ApprovedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ExpiresAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "Approver": {"$ref": "#/$defs/person"},
    "Operator": {"type": "object", "additionalProperties": false, "required": ["Name", "Role", "Uid"], "properties": {"Name": {"const": "cdjensen94"}, "Role": {"type": "string", "minLength": 1}, "Uid": {"const": 1000}}},
    "ExecutionHost": {"type": "object", "additionalProperties": false, "required": ["HostName", "UnixUser", "Uid", "RootlessPodman"], "properties": {"HostName": {"const": "christian-laptop"}, "UnixUser": {"const": "cdjensen94"}, "Uid": {"const": 1000}, "RootlessPodman": {"const": true}}},
    "Targets": {"type": "object", "additionalProperties": false, "required": ["Source", "Destination"], "properties": {"Source": {"$ref": "#/$defs/source"}, "Destination": {"$ref": "#/$defs/destination"}}},
    "PermittedOperations": {"const": {"ReadOnlyPodmanInspection": true, "PayloadFreeTcpConnect": true, "NoDatabaseClient": true, "NoSql": true, "NoCredentialAccess": true, "NoLifecycleChanges": true, "NoPodmanExec": true, "NoNetworkConfigurationChanges": true, "RetainSanitizedEvidence": true}},
    "Limits": {"type": "object", "additionalProperties": false, "required": ["TcpConnectTimeoutSeconds", "AttemptsPerEndpoint", "OverallTimeoutSeconds"], "properties": {"TcpConnectTimeoutSeconds": {"const": 3}, "AttemptsPerEndpoint": {"const": 1}, "OverallTimeoutSeconds": {"const": 600}}},
    "Evidence": {"type": "object", "additionalProperties": false, "required": ["ManifestPath", "PreflightReportPath", "ResultReportPath"], "properties": {"ManifestPath": {"type": "string", "pattern": "^/home/cdjensen94/continuumwiki-validation/cw-m5-026b-connectivity-[A-Za-z0-9._:-]+/authorization\\.json$"}, "PreflightReportPath": {"type": "string", "pattern": "^/home/cdjensen94/continuumwiki-validation/cw-m5-026b-connectivity-[A-Za-z0-9._:-]+/preflight\\.json$"}, "ResultReportPath": {"type": "string", "pattern": "^/home/cdjensen94/continuumwiki-validation/cw-m5-026b-connectivity-[A-Za-z0-9._:-]+/result\\.json$"}}}
  },
  "$defs": {
    "person": {"type": "object", "additionalProperties": false, "required": ["Name", "Role"], "properties": {"Name": {"type": "string", "minLength": 1}, "Role": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["ContainerName", "ContainerId", "ProvisioningRunId", "Endpoint"], "properties": {"ContainerName": {"const": "continuumwiki-m5-026b-source-ro1"}, "ContainerId": {"const": "6a4d4f8707ee4f5b14dddfff183db6d26ce7453eaba377b7c9d081bc1157f914"}, "ProvisioningRunId": {"const": "20261012T093746Z-86380"}, "Endpoint": {"const": "127.0.0.1:13326"}}},
    "destination": {"type": "object", "additionalProperties": false, "required": ["ContainerName", "ContainerId", "ProvisioningRunId", "Endpoint"], "properties": {"ContainerName": {"const": "continuumwiki-m5-026b-destination-ro1"}, "ContainerId": {"const": "1c58a2f370d36af443e53283d4212604e997188e9fbf81175655446b7c3ea1f5"}, "ProvisioningRunId": {"const": "20261012T123438Z-282573-599fff18456ea0cf36ef987019b3efef"}, "Endpoint": {"const": "127.0.0.1:13327"}}}
  }
}
