{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cw-m5-026b-stopped-source-restart-authorization-v1",
  "title": "One-shot authorization to start the existing CW-M5-026B source container",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ManifestVersion", "ApprovalId", "ApprovedAtUtc", "ExpiresAtUtc",
    "Approver", "Operator", "TargetOwner", "ExecutionHost", "Target",
    "DiagnosticClassification", "DiagnosticReportSha256", "PermittedOperations",
    "ResultReportPath"
  ],
  "properties": {
    "ManifestVersion": {"const": "cw-m5-026b-stopped-source-restart-authorization-v1"},
    "ApprovalId": {"type": "string", "pattern": "^CW-M5-026B-RECOVERY-START-[A-Za-z0-9._:-]{1,80}$"},
    "ApprovedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ExpiresAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "Approver": {"$ref": "#/$defs/person"},
    "Operator": {"$ref": "#/$defs/person"},
    "TargetOwner": {"type": "string", "minLength": 1, "maxLength": 160},
    "ExecutionHost": {
      "type": "object", "additionalProperties": false,
      "required": ["HostName", "UnixUser", "Uid", "RootlessPodman"],
      "properties": {
        "HostName": {"const": "christian-laptop"},
        "UnixUser": {"const": "cdjensen94"},
        "Uid": {"const": 1000},
        "RootlessPodman": {"const": true}
      }
    },
    "Target": {
      "type": "object", "additionalProperties": false,
      "required": ["ContainerName", "ContainerId", "ImageReference", "VolumeName", "DatabaseName", "Endpoint", "ProvisioningRunId"],
      "properties": {
        "ContainerName": {"const": "continuumwiki-m5-026b-source-ro1"},
        "ContainerId": {"const": "6a4d4f8707ee4f5b14dddfff183db6d26ce7453eaba377b7c9d081bc1157f914"},
        "ImageReference": {"const": "docker.io/library/mariadb@sha256:6422478cb8e159f080fb1d8ccf65101e26fe51385787fde7d16c3b165a331f15"},
        "VolumeName": {"const": "continuumwiki-m5-026b-source-ro1-data"},
        "DatabaseName": {"const": "cw_m5_026b_source_ro1"},
        "Endpoint": {"const": "127.0.0.1:13326"},
        "ProvisioningRunId": {"const": "20261012T093746Z-86380"}
      }
    },
    "DiagnosticClassification": {"const": "SOURCE_CONTAINER_STOPPED_IDENTITY_MATCH"},
    "DiagnosticReportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "PermittedOperations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "StartStoppedSourceContainerOnce", "ContainerCreation", "ContainerRecreation",
        "ContainerRestart", "ImageOrVolumeChanges", "DatabaseConnections",
        "DatabaseMutations", "Migrations", "GrantChanges", "FixtureWrites",
        "Backup", "Restore", "Cleanup", "ContainerVolumeDeletion", "ProductionAccess"
      ],
      "properties": {
        "StartStoppedSourceContainerOnce": {"const": true},
        "ContainerCreation": {"const": false},
        "ContainerRecreation": {"const": false},
        "ContainerRestart": {"const": false},
        "ImageOrVolumeChanges": {"const": false},
        "DatabaseConnections": {"const": false},
        "DatabaseMutations": {"const": false},
        "Migrations": {"const": false},
        "GrantChanges": {"const": false},
        "FixtureWrites": {"const": false},
        "Backup": {"const": false},
        "Restore": {"const": false},
        "Cleanup": {"const": false},
        "ContainerVolumeDeletion": {"const": false},
        "ProductionAccess": {"const": false}
      }
    },
    "ResultReportPath": {"type": "string", "pattern": "^/home/cdjensen94/continuumwiki-validation/[A-Za-z0-9._/-]+$"}
  },
  "$defs": {
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["Name", "Role"],
      "properties": {
        "Name": {"type": "string", "minLength": 1, "maxLength": 160},
        "Role": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    }
  }
}
