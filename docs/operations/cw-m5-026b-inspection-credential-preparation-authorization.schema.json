        "DatabaseConnections": {"const": false},
        "PodmanCommands": {"const": false},
        "Migrations": {"const": false},
        "GrantChanges": {"const": false},
        "FixtureWrites": {"const": false},
        "Backup": {"const": false},
        "Restore": {"const": false},
        "Cleanup": {"const": false},
        "DeleteExistingCredentialFiles": {"const": false},
        "ProductionAccess": {"const": false},
        "CredentialValueLogging": {"const": false}
